class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: bool
        """
        n=len(nums)
        mpp={}
        for i in range(n):
            if nums[i] in mpp and i-mpp[nums[i]]<=k:
                return True
            mpp[nums[i]]=i
        return False
nums = [1,2,3,1]
k = 3
solution = Solution()
result = solution.containsNearbyDuplicate(nums, k)
print(result)