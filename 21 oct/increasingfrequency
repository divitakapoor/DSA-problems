class Solution(object):
    def frequencySort(self, nums):
        freq = {}

        # Step 1: Count frequency
        for num in nums:
            if num in freq:
                freq[num] += 1
            else:
                freq[num] = 1

        # Step 2: Sort using bubble sort
        n = len(nums)

        for i in range(n):
            for j in range(0, n - i - 1):
                a = nums[j]
                b = nums[j + 1]

                if freq[a] > freq[b] or (freq[a] == freq[b] and a < b):
                    nums[j], nums[j + 1] = nums[j + 1], nums[j]

        return nums
arr = [4, 4, 1, 1, 2, 2, 3]
solution = Solution()
print(solution.frequencySort(arr))