def kthSmallestElement(arr,k):
    for i in range(len(arr)):
        min_index=i
        for j in range(i+1,len(arr)):
            if arr[j]<arr[min_index]:
                min_index=j
        arr[i], arr[min_index] = arr[min_index], arr[i]
    return arr[k-1]
arr=[7,10,4,3,20,15]
k=3
print("Kth smallest element is:", kthSmallestElement(arr,k))