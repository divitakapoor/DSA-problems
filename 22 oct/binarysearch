def binarysearch(arr,n,offset=0):
    if len(arr)==0:
        return -1
    left=0
    right=len(arr)-1
    mid=(left+right)//2
    if n==arr[mid]:
        return offset+mid
    elif n<arr[mid]:
        return binarysearch(arr[:mid],n,offset+mid)
    else:
        return binarysearch(arr[mid+1:],n,offset+mid+1)
arr=[1,2,3,4,5,6,7,8]
n=5 
print(binarysearch(arr,n))
