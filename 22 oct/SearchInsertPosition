def searchinsertposition(arr):
    n = int(input("Enter the number to search: "))
    left = 0
    right = len(arr) - 1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == n:
            return mid
        elif arr[mid] < n:
            left = mid + 1
        else:
            right = mid - 1

    return left
arr = [1, 3, 5, 6]
print(searchinsertposition(arr))