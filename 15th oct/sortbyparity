def sortArrayByParity(nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        n= len(nums)
        for i in range (n):
            for j in range(n-i-1):
                if nums[j]%2!=0:
                    nums[j],nums[j+1]=nums[j+1],nums[j]
        return nums
nums=[3,1,2,4]
print("Sorted array is:", sortArrayByParity(nums))
        