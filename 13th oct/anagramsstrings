class Solution:
    def findAnagrams(self, s, p):
        if len(p) > len(s):
            return []

        result = []
        p_count = [0] * 26
        s_count = [0] * 26

        for ch in p:
            p_count[ord(ch) - ord('a')] += 1

        for ch in s[:len(p)]:
            s_count[ord(ch) - ord('a')] += 1

        for i in range(len(s) - len(p) + 1):
            if s_count == p_count:
                result.append(i)

            if i + len(p) < len(s):
                s_count[ord(s[i]) - ord('a')] -= 1
                s_count[ord(s[i + len(p)]) - ord('a')] += 1

        return result


s = "cbaebabacd"
p = "abc"

solution = Solution()
print(solution.findAnagrams(s, p))