def minSubArrayLen(target,nums):
    n = len(nums)
    i= 0
    csum = 0
    min_length = float('inf')
    for j in range(n):
        csum+= nums[j]
        while csum >= target:
            min_length = min(min_length, j - i + 1)
            csum -= nums[i]
            i += 1
    return min_length if min_length != float('inf') else 0
target = 7
nums = [2,3,1,2,4,3]
result = minSubArrayLen(target, nums)
print(result)  